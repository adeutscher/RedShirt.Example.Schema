# Copy to `.env` and set values before running `docker-update.sh`.
# When the database runs on the host machine, use host.docker.internal for EXAMPLE_SCHEMA_HOST.

EXAMPLE_SCHEMA_HOST=127.0.0.1
EXAMPLE_SCHEMA_NAME=example
EXAMPLE_SCHEMA_USER=db-user
EXAMPLE_SCHEMA_PASSWORD=

# Set to 1 to list pending scripts without applying them.
# EXAMPLE_SCHEMA_DRY_RUN=1
